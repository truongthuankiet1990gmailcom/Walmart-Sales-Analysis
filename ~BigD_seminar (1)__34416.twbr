            <column caption='% Diff Profit' datatype='real' default-format='p0.0%' name='[Calculation_563794407275270159]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_563794407274328077]) - SUM([Calculation_563794407274885134])) / SUM([Calculation_563794407274885134])' />
